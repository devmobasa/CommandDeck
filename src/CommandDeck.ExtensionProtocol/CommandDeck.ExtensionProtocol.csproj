<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Source-generated JSON must retain the reserved experimental event wire shapes. Consumers still receive CDEXT0001. -->
    <NoWarn>$(NoWarn);CDEXT0001</NoWarn>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <Version>0.1.0-preview.6</Version>
    <Description>Experimental independent CommandDeck extension wire protocol.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
